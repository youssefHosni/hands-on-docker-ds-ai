{
  "name": "House prices",
  // Build the image from the project's own Dockerfile
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  // Mount the project at /project, as we did with docker run -v
  "workspaceMount": "source=${localWorkspaceFolder},target=/project,type=bind",
  "workspaceFolder": "/project",
  // Work as the image's regular user; on Linux, its UID is changed to match yours
  "remoteUser": "appuser",
  "forwardPorts": [8888],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python"
      }
    }
  }
}
